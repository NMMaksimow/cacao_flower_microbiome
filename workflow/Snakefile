# =============================================================================
# Cacao Flower Microbiome — QIIME2 amplicon pipeline
# =============================================================================
# Starts from primer-trimmed, demultiplexed FASTQs described by a manifest.
# Steps: import → DADA2 → NB taxonomy → phylogeny (16S only) → export
#
# Usage (dry-run first):
#   snakemake -n --snakefile workflow/Snakefile
#
# Submit to SLURM — Snakemake 7 (--cluster):
#   snakemake --snakefile workflow/Snakefile \
#     --configfile workflow/config_CFM.yaml \   # or config_wemheuer.yaml / config_schmidt.yaml
#     --cluster "sbatch -p {resources.partition} \
#                       --mem={resources.mem_mb}M \
#                       -c {resources.cpus} \
#                       -t {resources.runtime} \
#                       --gres=tmp:{resources.tmp_gb}G \
#                       -o logs/{rule}.slurm.out \
#                       -e logs/{rule}.slurm.err \
#                       --mail-type=FAIL" \
#     --jobs 6 --latency-wait 60
#
# Snakemake 8+ uses --executor cluster-generic --cluster-generic-submit-cmd instead.
#
# To run only trimming (before manifests exist):
#   snakemake --snakefile workflow/Snakefile \
#     --configfile workflow/config_wemheuer.yaml \
#     "qiime2_wemheuer/import/primer_trimmed/16S/.done" \
#     "qiime2_wemheuer/import/primer_trimmed/ITS2/.done" \
#     --cluster "sbatch ..." --jobs 2 --latency-wait 60
# =============================================================================

# Default config — overridden by --configfile on the command line.
# Always pass --configfile explicitly when reanalysing other datasets.
configfile: "workflow/config_CFM.yaml"

# ── Resolve config values ─────────────────────────────────────────────────────
DATASET       = config["dataset"]
MANIFEST_16S  = config["manifest_16s"]
MANIFEST_ITS1 = config.get("manifest_its2", config.get("manifest_its1", ""))   # its2 key for ITS2 datasets, its1 for CFM
DB_DIR        = config["db_dir"]
DENOISE_DIR   = config["denoise_dir"]
TAXONOMY_DIR  = config["taxonomy_dir"]
PHYLO_DIR     = config["phylo_dir"]
EXPORT_DIR    = config["export_dir"]

SILVA_CLASSIFIER = config["silva_classifier"]
UNITE_CLASSIFIER = config.get("unite_classifier", "")

# ITS amplicon label used in output filenames.
# Defaults to "ITS1" (correct for CFM V-ITS1 amplicon).
# Set its_label: "ITS2" in config for datasets amplifying the ITS2 region
# (e.g. Wemheuer 2020: ITS3_KYO2 / ITS4 primers).
ITS_LABEL = config.get("its_label", "ITS1")

# ── DADA2 truncation parameters (dataset-specific) ────────────────────────────
# Defaults: 0 = no truncation (fine for CFM 2×250bp V4 high-quality reads).
# For 2×300bp datasets set in config (16S and ITS may differ — check QC .qzv).
DADA2_TRUNC_F     = config.get("dada2_trunc_len_f", 0)
DADA2_TRUNC_R     = config.get("dada2_trunc_len_r", 0)
DADA2_MAX_EE_F    = config.get("dada2_max_ee_f", 2.0)
DADA2_MAX_EE_R    = config.get("dada2_max_ee_r", 2.0)
# ITS-specific overrides (fall back to 16S values if not set)
DADA2_TRUNC_F_ITS = config.get("dada2_trunc_len_f_its", DADA2_TRUNC_F)
DADA2_TRUNC_R_ITS = config.get("dada2_trunc_len_r_its", DADA2_TRUNC_R)
DADA2_MAX_EE_F_ITS = config.get("dada2_max_ee_f_its", DADA2_MAX_EE_F)
DADA2_MAX_EE_R_ITS = config.get("dada2_max_ee_r_its", DADA2_MAX_EE_R)

DO_ITS1 = bool(MANIFEST_ITS1 and UNITE_CLASSIFIER)

# ── ITS OTU clustering (post-DADA2 vsearch de-novo) ──────────────────────────
# ITS amplicons have intragenomic polymorphism → one organism → multiple ASVs.
# 97% OTU clustering collapses this noise and gives a more reliable phylogeny
# for downstream PhILR analysis. Outputs exported alongside DADA2 ASV files.
ITS_OTU_PERC  = config.get("its_otu_perc_identity", 0.97)
ITS_OTU_LABEL = f"otu{int(ITS_OTU_PERC * 100)}"   # e.g. "otu97"

# ── Primer trimming (optional) ────────────────────────────────────────────────
# Only active when raw_fastq_dir + primers are defined in config (e.g. Wemheuer).
# For CFM these keys are absent → trim rules are never triggered.
RAW_FASTQ_DIR    = config.get("raw_fastq_dir", "")
TRIMMED_16S_DIR  = config.get("trimmed_16s_dir", "")
TRIMMED_ITS2_DIR = config.get("trimmed_its2_dir", "")
PRIMER_16S_FWD   = config.get("primer_16s_fwd", "")
PRIMER_16S_REV   = config.get("primer_16s_rev", "")
PRIMER_ITS2_FWD  = config.get("primer_its2_fwd", "")
PRIMER_ITS2_REV  = config.get("primer_its2_rev", "")
DO_TRIM          = bool(RAW_FASTQ_DIR and TRIMMED_16S_DIR and PRIMER_16S_FWD)

# Collect SRR sample IDs from raw fastq dir (when trimming is needed)
if DO_TRIM:
    import glob, re, csv
    _all_r1 = glob.glob(f"{RAW_FASTQ_DIR}/SRR*_1.fastq.gz")
    ALL_SRRS = sorted(re.sub(r"_1\.fastq\.gz$", "", os.path.basename(f)) for f in _all_r1)
    # Split by amplicon using runinfo.csv LibraryName prefix
    _srr2lib = {}
    _runinfo = os.path.join(os.path.dirname(RAW_FASTQ_DIR), "runinfo.csv")
    if not os.path.exists(_runinfo):
        _runinfo = os.path.join(RAW_FASTQ_DIR, "..", "runinfo.csv")
    if os.path.exists(_runinfo):
        with open(_runinfo) as _fh:
            for _row in csv.DictReader(_fh):
                _srr2lib[_row["Run"].strip()] = _row["LibraryName"].strip()
    # lib_16s_pattern / lib_its_pattern: configurable prefix for splitting runs.
    # Wemheuer: "Bac" / "Fun" (default).  Lewis: "16S" / "ITS".
    _16s_pat = config.get("lib_16s_pattern", "Bac")
    _its_pat = config.get("lib_its_pattern", "Fun")
    BAC_SRRS = [s for s in ALL_SRRS if _16s_pat in _srr2lib.get(s, "")]
    FUN_SRRS = [s for s in ALL_SRRS if _its_pat in _srr2lib.get(s, "")]

# ── Target outputs ─────────────────────────────────────────────────────────────
def all_targets():
    targets = [
        # DADA2 visualisations — 16S
        f"{DENOISE_DIR}/{DATASET}_16S_dada2_stats_summary.qzv",
        f"{DENOISE_DIR}/{DATASET}_16S_dada2_table_summary.qzv",
        f"{DENOISE_DIR}/{DATASET}_16S_dada2_repseqs_summary.qzv",
        # downstream
        f"{EXPORT_DIR}/{DATASET}_16S_dada2_table/feature-table.biom",
        f"{EXPORT_DIR}/{DATASET}_16S_dada2_repseqs/dna-sequences.fasta",
        f"{EXPORT_DIR}/{DATASET}_16S_taxonomy/taxonomy.tsv",
        f"{EXPORT_DIR}/{DATASET}_16S_rooted_tree/tree.nwk",
    ]
    if DO_ITS1:
        targets += [
            # DADA2 visualisations — ITS
            f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_stats_summary.qzv",
            f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_table_summary.qzv",
            f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_repseqs_summary.qzv",
            # downstream — ASV level
            f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_dada2_table/feature-table.biom",
            f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_dada2_repseqs/dna-sequences.fasta",
            f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_taxonomy/taxonomy.tsv",
            # downstream — OTU level (vsearch de-novo clustering)
            f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_table/feature-table.biom",
            f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_repseqs/dna-sequences.fasta",
            f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_taxonomy/taxonomy.tsv",
        ]
    if DO_TRIM:
        targets += [
            f"{TRIMMED_16S_DIR}/.done",
            f"{TRIMMED_ITS2_DIR}/.done",
        ]
    return targets

rule all:
    input: all_targets()


# =============================================================================
# 0. PRIMER TRIMMING  (only for datasets with raw SRA reads, e.g. Wemheuer)
# =============================================================================

rule trim_primers_16s:
    """Cutadapt: remove Nextera adapters + 16S V3-V4 primers (341F/785R) from Bac_* samples."""
    input:
        expand(f"{RAW_FASTQ_DIR}/{{srr}}_1.fastq.gz", srr=BAC_SRRS) if DO_TRIM else [],
    output:
        touch(f"{TRIMMED_16S_DIR}/.done"),
    log:
        f"logs/snakemake_{DATASET}_trim_primers_16s.log",
    resources:
        partition = "shared",
        mem_mb    = 8_000,
        cpus      = 8,
        runtime   = "04:00:00",
        tmp_gb    = 20,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics
        module load qiime2/2024.10amplicon   # cutadapt is bundled in qiime2 env

        mkdir -p {TRIMMED_16S_DIR}

        for srr in {BAC_SRRS}; do
            r1={RAW_FASTQ_DIR}/${{srr}}_1.fastq.gz
            r2={RAW_FASTQ_DIR}/${{srr}}_2.fastq.gz
            o1={TRIMMED_16S_DIR}/${{srr}}_1.trimmed.fastq.gz
            o2={TRIMMED_16S_DIR}/${{srr}}_2.trimmed.fastq.gz

            cutadapt \
                -g {PRIMER_16S_FWD} \
                -G {PRIMER_16S_REV} \
                --discard-untrimmed \
                --minimum-length 50 \
                --maximum-length 600 \
                -j {resources.cpus} \
                -o $o1 -p $o2 \
                $r1 $r2 \
                >> {log} 2>&1

            echo "Done: $srr" >> {log}
        done
        """


rule trim_primers_its2:
    """Cutadapt: remove Nextera adapters + ITS3_KYO2/ITS4 primers from Fun_* samples.
    Note: ITS1-F_KYO2 (round-1 primer) is NOT present in reads — nested PCR means
    reads start directly with ITS3_KYO2 (round-2 primer + Nextera adapter).
    This amplifies the ITS2 region (5.8S boundary → 28S boundary).
    """
    input:
        expand(f"{RAW_FASTQ_DIR}/{{srr}}_1.fastq.gz", srr=FUN_SRRS) if DO_TRIM else [],
    output:
        touch(f"{TRIMMED_ITS2_DIR}/.done"),
    log:
        f"logs/snakemake_{DATASET}_trim_primers_its2.log",
    resources:
        partition = "shared",
        mem_mb    = 8_000,
        cpus      = 8,
        runtime   = "04:00:00",
        tmp_gb    = 20,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics
        module load qiime2/2024.10amplicon

        mkdir -p {TRIMMED_ITS2_DIR}

        for srr in {FUN_SRRS}; do
            r1={RAW_FASTQ_DIR}/${{srr}}_1.fastq.gz
            r2={RAW_FASTQ_DIR}/${{srr}}_2.fastq.gz
            o1={TRIMMED_ITS2_DIR}/${{srr}}_1.trimmed.fastq.gz
            o2={TRIMMED_ITS2_DIR}/${{srr}}_2.trimmed.fastq.gz

            cutadapt \
                -g {PRIMER_ITS2_FWD} \
                -G {PRIMER_ITS2_REV} \
                --discard-untrimmed \
                --minimum-length 50 \
                --maximum-length 600 \
                -j {resources.cpus} \
                -o $o1 -p $o2 \
                $r1 $r2 \
                >> {log} 2>&1

            echo "Done: $srr" >> {log}
        done
        """


# =============================================================================
# 1. QIIME2 IMPORT
# =============================================================================

rule import_16s:
    """Import primer-trimmed 16S paired-end FASTQs from manifest."""
    input:
        manifest = MANIFEST_16S,
    output:
        qza = f"{DENOISE_DIR}/{DATASET}_16S_PE_import.qza",
        qzv = f"{DENOISE_DIR}/{DATASET}_16S_PE_import_QC.qzv",
    log:
        f"logs/snakemake_{DATASET}_import_16s.log",
    resources:
        partition = "shared",
        mem_mb    = 16_000,   # 16 G — import is IO-bound, not memory-bound
        cpus      = 4,
        runtime   = "02:00:00",
        tmp_gb    = 20,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon
        export TMPDIR=/nobackup/jcnx71/tmp

        mkdir -p {DENOISE_DIR}

        qiime tools import \
            --type 'SampleData[PairedEndSequencesWithQuality]' \
            --input-path {input.manifest} \
            --output-path {output.qza} \
            --input-format PairedEndFastqManifestPhred33V2 \
            >> {log} 2>&1

        qiime demux summarize \
            --i-data {output.qza} \
            --o-visualization {output.qzv} \
            >> {log} 2>&1
        """


rule import_its1:
    """Import primer-trimmed ITS1/ITS2 paired-end FASTQs from manifest."""
    input:
        manifest = MANIFEST_ITS1,
    output:
        qza = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_PE_import.qza",
        qzv = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_PE_import_QC.qzv",
    log:
        f"logs/snakemake_{DATASET}_import_its1.log",
    resources:
        partition = "shared",
        mem_mb    = 16_000,
        cpus      = 4,
        runtime   = "02:00:00",
        tmp_gb    = 20,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon
        export TMPDIR=/nobackup/jcnx71/tmp

        mkdir -p {DENOISE_DIR}

        qiime tools import \
            --type 'SampleData[PairedEndSequencesWithQuality]' \
            --input-path {input.manifest} \
            --output-path {output.qza} \
            --input-format PairedEndFastqManifestPhred33V2 \
            >> {log} 2>&1

        qiime demux summarize \
            --i-data {output.qza} \
            --o-visualization {output.qzv} \
            >> {log} 2>&1
        """


# =============================================================================
# 2. DADA2 DENOISING  (16S and ITS1 run independently)
# =============================================================================
# Timing from CFM logs:
#   16S:  08:33 → 11:42  (~3h 09m, 64G, 16 CPUs)
#   ITS1: 11:45 → 13:15  (~1h 30m, 64G, 16 CPUs)
# Requesting 12h to give headroom for larger/more complex datasets.

rule dada2_16s:
    """DADA2 paired-end denoising for 16S."""
    input:
        f"{DENOISE_DIR}/{DATASET}_16S_PE_import.qza",
    output:
        table   = f"{DENOISE_DIR}/{DATASET}_16S_dada2_table.qza",
        repseqs = f"{DENOISE_DIR}/{DATASET}_16S_dada2_repseqs.qza",
        stats   = f"{DENOISE_DIR}/{DATASET}_16S_dada2_stats.qza",
    log:
        f"logs/snakemake_{DATASET}_dada2_16s.log",
    resources:
        partition = "shared",
        mem_mb    = 65_536,   # 64 G
        cpus      = 16,
        runtime   = "12:00:00",
        tmp_gb    = 50,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon
        export TMPDIR=/nobackup/jcnx71/tmp

        qiime dada2 denoise-paired \
            --i-demultiplexed-seqs {input} \
            --p-trunc-len-f {DADA2_TRUNC_F} \
            --p-trunc-len-r {DADA2_TRUNC_R} \
            --p-trim-left-f 0 \
            --p-trim-left-r 0 \
            --p-max-ee-f {DADA2_MAX_EE_F} \
            --p-max-ee-r {DADA2_MAX_EE_R} \
            --p-min-overlap 12 \
            --p-chimera-method consensus \
            --p-n-threads {resources.cpus} \
            --o-table {output.table} \
            --o-representative-sequences {output.repseqs} \
            --o-denoising-stats {output.stats} \
            --verbose \
            >> {log} 2>&1
        """


rule dada2_its1:
    """DADA2 paired-end denoising for ITS1/ITS2."""
    input:
        f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_PE_import.qza",
    output:
        table   = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_table.qza",
        repseqs = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_repseqs.qza",
        stats   = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_stats.qza",
    log:
        f"logs/snakemake_{DATASET}_dada2_its1.log",
    resources:
        partition = "shared",
        mem_mb    = 65_536,   # 64 G
        cpus      = 16,
        runtime   = "06:00:00",  # ITS1 historically ~1.5h; 6h is safe
        tmp_gb    = 50,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon
        export TMPDIR=/nobackup/jcnx71/tmp

        qiime dada2 denoise-paired \
            --i-demultiplexed-seqs {input} \
            --p-trunc-len-f {DADA2_TRUNC_F_ITS} \
            --p-trunc-len-r {DADA2_TRUNC_R_ITS} \
            --p-trim-left-f 0 \
            --p-trim-left-r 0 \
            --p-max-ee-f {DADA2_MAX_EE_F_ITS} \
            --p-max-ee-r {DADA2_MAX_EE_R_ITS} \
            --p-min-overlap 12 \
            --p-chimera-method consensus \
            --p-n-threads {resources.cpus} \
            --o-table {output.table} \
            --o-representative-sequences {output.repseqs} \
            --o-denoising-stats {output.stats} \
            --verbose \
            >> {log} 2>&1
        """


# =============================================================================
# 2b. DADA2 VISUALISATIONS  (run in parallel with taxonomy — lightweight)
# =============================================================================

rule visualize_dada2_16s:
    """Summarise DADA2 stats, feature table, and rep-seqs for 16S."""
    input:
        stats   = f"{DENOISE_DIR}/{DATASET}_16S_dada2_stats.qza",
        table   = f"{DENOISE_DIR}/{DATASET}_16S_dada2_table.qza",
        repseqs = f"{DENOISE_DIR}/{DATASET}_16S_dada2_repseqs.qza",
    output:
        stats_qzv   = f"{DENOISE_DIR}/{DATASET}_16S_dada2_stats_summary.qzv",
        table_qzv   = f"{DENOISE_DIR}/{DATASET}_16S_dada2_table_summary.qzv",
        repseqs_qzv = f"{DENOISE_DIR}/{DATASET}_16S_dada2_repseqs_summary.qzv",
    log:
        f"logs/snakemake_{DATASET}_visualize_dada2_16s.log",
    resources:
        partition = "shared",
        mem_mb    = 4_000,
        cpus      = 2,
        runtime   = "00:30:00",
        tmp_gb    = 5,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon

        qiime metadata tabulate \
            --m-input-file {input.stats} \
            --o-visualization {output.stats_qzv} \
            >> {log} 2>&1

        qiime feature-table summarize \
            --i-table {input.table} \
            --o-visualization {output.table_qzv} \
            >> {log} 2>&1

        qiime feature-table tabulate-seqs \
            --i-data {input.repseqs} \
            --o-visualization {output.repseqs_qzv} \
            >> {log} 2>&1
        """


rule visualize_dada2_its1:
    """Summarise DADA2 stats, feature table, and rep-seqs for ITS1/ITS2."""
    input:
        stats   = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_stats.qza",
