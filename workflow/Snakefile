# =============================================================================
# 6. ITS OTU CLUSTERING  (vsearch de-novo, post-DADA2)
# =============================================================================
# ITS amplicons have intragenomic length polymorphism → one fungal strain can
# produce 2-5 distinct ASVs. De-novo OTU clustering at 97% collapses this
# noise. Outputs are used for:
#   - PhILR analysis (09b_ITS1_philr.R): smaller, more reliable tree
#   - OTU-level diversity comparisons across datasets
#
# Rule graph: dada2_its1 → cluster_its1_otus → taxonomy_its1_otu → export_its1_otu


rule cluster_its1_otus:
    """vsearch de-novo OTU clustering of ITS1/ITS2 DADA2 ASVs."""
    input:
        table   = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_table.qza",
        repseqs = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_dada2_repseqs.qza",
    output:
        table   = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_table.qza",
        repseqs = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_repseqs.qza",
    log:
        f"logs/snakemake_{DATASET}_cluster_its1_{ITS_OTU_LABEL}.log",
    resources:
        partition = "shared",
        mem_mb    = 16_000,
        cpus      = 8,
        runtime   = "02:00:00",
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon
        export TMPDIR=/nobackup/jcnx71/tmp

        echo "vsearch OTU clustering at {ITS_OTU_PERC} identity"
        echo "Input ASV table:   {input.table}"
        echo "Input ASV repseqs: {input.repseqs}"
        echo "Date: $(date)"

        qiime vsearch cluster-features-de-novo \
            --i-table   {input.table} \
            --i-sequences {input.repseqs} \
            --p-perc-identity {ITS_OTU_PERC} \
            --p-threads {resources.cpus} \
            --o-clustered-table     {output.table} \
            --o-clustered-sequences {output.repseqs} \
            --verbose \
            >> {log} 2>&1

        echo "Done: $(date)" >> {log}
        """


rule taxonomy_its1_otu:
    """Naive Bayes classification of ITS OTU representative sequences.

    NOTE: --p-n-jobs 1 (not 8) — UNITE classifier is 545MB; each sklearn
    worker loads its own copy. 8 workers × ~15GB = OOM on 64GB bigmem.
    Single-threaded classification is slower (~1-2h) but reliable.
    Taxonomy TSV is exported immediately after classification.
    """
    input:
        repseqs    = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_repseqs.qza",
        classifier = UNITE_CLASSIFIER,
    output:
        taxonomy = f"{TAXONOMY_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_taxonomy.qza",
        tax_tsv  = f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_taxonomy/taxonomy.tsv",
    log:
        f"logs/snakemake_{DATASET}_taxonomy_its1_{ITS_OTU_LABEL}.log",
    resources:
        partition = "bigmem",
        mem_mb    = 120_000,
        cpus      = 1,
        runtime   = "04:00:00",
        tmp_gb    = 50,
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon
        export TMPDIR=/nobackup/jcnx71/tmp

        echo "NB taxonomy on {ITS_OTU_LABEL} repseqs (single-threaded)"
        echo "Date: $(date)"

        mkdir -p {TAXONOMY_DIR} {EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_taxonomy

        qiime feature-classifier classify-sklearn \
            --i-classifier  {input.classifier} \
            --i-reads       {input.repseqs} \
            --p-n-jobs 1 \
            --o-classification {output.taxonomy} \
            --verbose \
            >> {log} 2>&1

        qiime tools export \
            --input-path {output.taxonomy} \
            --output-path {EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_taxonomy \
            >> {log} 2>&1

        echo "Done: $(date)" >> {log}
        """


rule export_its1_otu:
    """Export ITS OTU table and repseqs to plain formats.
    Taxonomy TSV is already produced by taxonomy_its1_otu — listed here as input.
    """
    input:
        table    = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_table.qza",
        repseqs  = f"{DENOISE_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_repseqs.qza",
        taxonomy = f"{TAXONOMY_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_taxonomy.qza",
        tax_tsv  = f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_taxonomy/taxonomy.tsv",
    output:
        biom    = f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_table/feature-table.biom",
        fasta   = f"{EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_repseqs/dna-sequences.fasta",
    log:
        f"logs/snakemake_{DATASET}_export_its1_{ITS_OTU_LABEL}.log",
    resources:
        partition = "shared",
        mem_mb    = 8_000,
        cpus      = 2,
        runtime   = "01:00:00",
    shell:
        r"""
        set -euo pipefail
        module load bioinformatics qiime2/2024.10amplicon
        export TMPDIR=/nobackup/jcnx71/tmp

        qiime tools export --input-path {input.table} \
            --output-path {EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_table \
            >> {log} 2>&1

        qiime tools export --input-path {input.repseqs} \
            --output-path {EXPORT_DIR}/{DATASET}_{ITS_LABEL}_{ITS_OTU_LABEL}_repseqs \
            >> {log} 2>&1
        """
